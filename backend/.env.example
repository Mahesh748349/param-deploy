PORT=5000
PARAM_SERVICE_URL=https://param-retrieval.onrender.com
PARAM_READ_KEY=your_param_read_key_here

# Required: use the same Supabase project and public key as the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
ALLOWED_ORIGINS=https://param-search-studio.netlify.app,http://localhost:5173

# Optional: readable summaries; retrieval and arithmetic do not require Gemini.
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated dataset topic terms. Omit to use Param museum defaults.
# DATASET_SCOPE_TERMS=param,museum,exhibit,visitor,engagement,dwell,sessions,telemetry,drawings
