# Environment variables: set in your host's secret settings, not in source control.
PARAM_DATASET=param
PARAM_STATE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
PARAM_BLOB_ROOT=s3://YOUR_PRIVATE_BUCKET/param
PARAM_VECTOR_BACKEND=qdrant
# Copy EXACTLY from Colab, including the same port and trailing slash choice.
PARAM_VECTOR_URL=https://YOUR_CLUSTER.cloud.qdrant.io
PARAM_VECTOR_KEY=YOUR_QDRANT_DATABASE_KEY
PARAM_COLLECTION_PREFIX=param_v3
PARAM_EXPECTED_INDEX_ID=PASTE_THE_INDEX_ID_FROM_COLAB
PARAM_RRF_K=60
PARAM_RERANK_ENABLED=true
PARAM_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
PARAM_RERANK_CANDIDATES=64
PARAM_RERANK_BATCH_SIZE=8
# Set only after labeled calibration/validation; omit entirely otherwise:
# PARAM_RERANK_MIN_SCORE=YOUR_VALIDATED_THRESHOLD
PARAM_MODEL_CACHE=/var/cache/param-models
PARAM_BATCH_SIZE=32
PARAM_IMAGE_BATCH_SIZE=2
PARAM_THREADS=2
PARAM_READ_KEY=GENERATE_A_RETRIEVAL_KEY
PARAM_INGEST_KEY=GENERATE_A_DIFFERENT_INTERNAL_INGESTION_KEY
# Only the optional filesystem watcher needs these:
PARAM_SOURCE_ROOT=/data/param
PARAM_SCAN_SECONDS=30
PORT=8000
# S3 uses IAM credentials or standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# To switch vector stores: PARAM_VECTOR_BACKEND=pgvector and PARAM_VECTOR_URL=postgresql+psycopg://...
